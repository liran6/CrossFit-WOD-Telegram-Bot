# --------------------------------------------------------------------------
# General Python Files
# --------------------------------------------------------------------------

# Byte-code files
*.pyc
__pycache__/

# Distribution / Packaging
.eggs/
*.egg-info/
dist/
build/

# Virtual Environment
# This is crucial. Never commit your virtual environment.
venv/
.venv/
env/

# --------------------------------------------------------------------------
# Specific to this Project (WOD Telegram Sender)
# --------------------------------------------------------------------------

# 1. API Keys and Environment Variables
# NEVER commit your secrets file!
# This file holds your GEMINI_API_KEY, TELEGRAM_BOT_TOKEN, etc.
.env

# 2. Database/Data Files (if you were to save status or WODs locally)
*.db
*.sqlite
data.json
log.txt

# --------------------------------------------------------------------------
# Testing and Cache Files
# --------------------------------------------------------------------------

# Pytest cache directory
.pytest_cache/

# Coverage files
.coverage
htmlcov/

# --------------------------------------------------------------------------
# IDE / Editor Files (Visual Studio Code)
# --------------------------------------------------------------------------

# VS Code directory (often holds settings, but we might want to keep some settings.json)
.vscode/

# Keep the .vscode/settings.json file if you configured 'extraPaths' there.
# If you want to commit specific settings, you can exclude the directory
# and then specifically include the file:
!.vscode/settings.json

# Temporary files created by VS Code
*.code-workspace